# 行尾规范：仓库内以 LF 存储（跨平台一致），检出时由 core.autocrlf 按平台转换。
* text=auto

# 源码 / 文档 / 构建脚本强制 LF
*.h text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Windows 脚本必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 图像与二进制不转换
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.webp binary
*.gif binary
*.tga binary
*.exe binary
*.dll binary
*.obj binary
*.lib binary
